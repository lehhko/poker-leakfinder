[Unit]
Description=Poker Leak Finder API
After=network.target

[Service]
User=poker
WorkingDirectory=/opt/poker-leakfinder
EnvironmentFile=/opt/poker-leakfinder/.env
ExecStart=/opt/poker-leakfinder/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
